COMPOSE_PROJECT_NAME=readarr-dev
READARR_CONTAINER_NAME=readarr-dev
READARR_IMAGE=ghcr.io/tvanroo/readarr:dev
READARR_BIND_ADDRESS=0.0.0.0
READARR_PORT=8789
READARR_CONFIG_DIR=/opt/arrs/config/readarr-dev
# Unraid user shares are commonly owned by nobody:users, which is 99:100.
READARR_UID=99
READARR_GID=100
UMASK=022
TZ=America/Los_Angeles

# The arrs VM mounts Unraid shares under /mnt/unraid, then binds them into
# containers at app-friendly paths.
READARR_MEDIA_DIR=/mnt/unraid/audiobooks
READARR_DOWNLOADS_DIR=/mnt/unraid/downloads

# Automatic self-hosted metadata source. The Development settings page can
# select "Automatic self-hosted rreading-glasses" without requiring any URL
# input when this compose stack is used.
RREADING_GLASSES_IMAGE=blampe/rreading-glasses:latest
RREADING_GLASSES_BIND_ADDRESS=127.0.0.1
RREADING_GLASSES_PORT=8788
RREADING_GLASSES_MEMORY_LIMIT=128m
RREADING_GLASSES_UPSTREAM=www.goodreads.com
RREADING_GLASSES_POSTGRES_IMAGE=postgres:17
RREADING_GLASSES_POSTGRES_DB=rreading-glasses
RREADING_GLASSES_POSTGRES_USER=rreading-glasses
RREADING_GLASSES_POSTGRES_PASSWORD=readarr-rreading-glasses

# Optional NFS mount managed by install-host.sh.
AUDIOBOOKS_NFS_SERVER=192.168.0.3
AUDIOBOOKS_NFS_EXPORT=/mnt/user/audiobooks
AUDIOBOOKS_MOUNT=/mnt/unraid/audiobooks
AUDIOBOOKS_NFS_OPTIONS=rw,_netdev,nofail

DOWNLOADS_NFS_SERVER=192.168.0.3
DOWNLOADS_NFS_EXPORT=/mnt/user/downloads
DOWNLOADS_MOUNT=/mnt/unraid/downloads
DOWNLOADS_NFS_OPTIONS=rw,_netdev,nofail
